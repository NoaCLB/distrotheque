[Unit]
Description=Distrothèque — mise à jour du catalogue
Documentation=file:///var/www/distrotheque/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/distrotheque
ExecStart=/usr/bin/python3 /var/www/distrotheque/update.py
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
UMask=0027
NoNewPrivileges=true
TimeoutStartSec=2h

# Le serveur de production est un conteneur LXC : les options de sandboxing
# systemd (ProtectSystem, PrivateTmp, ReadWritePaths…) y échouent avec
# « Failed to set up mount namespacing » (status 226/NAMESPACE).

[Install]
WantedBy=multi-user.target
